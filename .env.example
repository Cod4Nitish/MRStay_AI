# ============================
# Project Configuration
# ============================

ENVIRONMENT=development
PROJECT_NAME=MRStay AI

# ============================
# Gemini API
# ============================

GEMINI_API_KEY=your_gemini_api_key_here

# ============================
# Database
# ============================

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ============================
# ChromaDB
# ============================

CHROMA_DB_PATH=data/chroma_db

# ============================
# Internal service calls (NestJS -> FastAPI)
# ============================

# FastAPI base URL used by the NestJS AiService
AI_SERVICE_URL=http://127.0.0.1:8000
# Shared secret for /internal/chat; the endpoint rejects calls while this is unset
INTERNAL_SERVICE_KEY=generate_a_long_random_value

# ============================
# Future Integrations
# ============================

WHATSAPP_API_KEY=your_whatsapp_api_key_here
